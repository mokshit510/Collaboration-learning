# PRAMAAN Environment Configuration Example
# Set VITE_USE_MOCK to 'true' for standalone hackathon demo mode (no backend required)
# Set VITE_USE_MOCK to 'false' to connect to the backend API services
VITE_USE_MOCK=true

# Backend API Base URL (used when VITE_USE_MOCK=false)
VITE_API_BASE_URL=http://localhost:8000
